{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "schedule": ["before 9am on friday"],
  "minimumReleaseAge": "7 days",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    ".github/workflows/release.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": ".github/workflows/release.yml は cargo-dist の生成物なので ignorePaths で Renovate から外し、中の action は dist-workspace.toml の github-action-commits 経由で更新する。\"owner/repo\" = \"<sha>\" # vX.Y.Z の形で、コメントの版が currentValue",
      "managerFilePatterns": ["/^dist-workspace\\.toml$/"],
      "matchStrings": [
        "^\"(?<depName>[^\"]+)\" = \"(?<currentDigest>[a-f0-9]{40})\" # (?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "action"
    },
    {
      "customType": "regex",
      "description": "dist-workspace.toml の cargo-dist-version",
      "managerFilePatterns": ["/^dist-workspace\\.toml$/"],
      "matchStrings": ["^cargo-dist-version = \"(?<currentValue>[^\"]+)\"\\s*$"],
      "depNameTemplate": "axodotdev/cargo-dist",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "CI 系の更新はアプリやライブラリの利用者に関係ないので ci ラベルを付ける。リリースノートを生成するリポジトリは .github/release.yml で除外する",
      "matchManagers": ["github-actions", "dockerfile", "devcontainer", "custom.regex"],
      "addLabels": ["ci"]
    },
    {
      "description": "1.0.0 以上の minor / patch は CI 通過後に automerge する。0.x は breaking change を含み得るので対象外",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "dist-workspace.toml の更新は release.yml の再生成 (dist generate) が要るので 1 つの PR にまとめ、automerge しない。merge 前に Renovate のブランチで dist generate して push する",
      "matchManagers": ["custom.regex"],
      "groupName": "cargo-dist",
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": "0 days",
    "schedule": ["at any time"]
  }
}
