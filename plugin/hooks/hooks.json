{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruminate hook --delay 3",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruminate hook --delay 0",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
